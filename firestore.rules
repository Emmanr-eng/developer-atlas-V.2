rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function isAdmin() {
      return isEmailVerified() && request.auth.token.get('email', '') == 'emmanuel@hurdman.net';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- User Profiles ---
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.role in ['user', 'admin'] &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidUser(incoming()) && incoming().role == 'user';
      allow update: if isAdmin() || (isOwner(userId) && isValidUser(incoming()) && incoming().role == existing().role);
    }

    // --- Projects (Ecosystem) ---
    function isValidProject(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.authorId is string &&
             data.createdAt is timestamp;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create: if isEmailVerified() && isValidProject(incoming()) && incoming().authorId == request.auth.uid;
      allow update: if (isAdmin() || isOwner(existing().authorId)) && 
                     incoming().authorId == existing().authorId &&
                     incoming().createdAt == existing().createdAt &&
                     isValidProject(incoming());
      allow delete: if isAdmin() || isOwner(existing().authorId);
    }

    // --- Blog Posts (Guides) ---
    function isValidPost(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.status in ['draft', 'published'] &&
             data.authorId is string &&
             data.authorName is string &&
             data.createdAt is timestamp;
    }

    match /posts/{postId} {
      allow list: if resource.data.status == 'published' || isAdmin();
      allow get: if resource.data.status == 'published' || isAdmin() || isOwner(resource.data.authorId);
      allow create: if isEmailVerified() && isValidPost(incoming()) && incoming().authorId == request.auth.uid;
      allow update: if (isAdmin() || isOwner(existing().authorId)) &&
                     incoming().authorId == existing().authorId &&
                     incoming().createdAt == existing().createdAt &&
                     isValidPost(incoming());
      allow delete: if isAdmin() || isOwner(existing().authorId);
    }

    // --- Contact Inquiries (Upgrade 5: tighter validation) ---
    function isValidInquiry(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 100 &&
             data.email.matches('^[^@]+@[^@]+\\.[^@]+$') &&
             data.message is string && data.message.size() >= 10 && data.message.size() <= 5000 &&
             data.status == 'new' &&
             data.createdAt is timestamp &&
             data.keys().hasOnly(['name', 'email', 'message', 'status', 'createdAt']);
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // Global Safety Net - Default Deny (Fallback)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
